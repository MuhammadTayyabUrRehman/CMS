# =============================================
# Ministry of Finance - Complaint Portal
# Environment Variables
# =============================================

# --- Database ---
# Local default: PostgreSQL on the same machine, database "finance_portal".
# Create it with:  createdb finance_portal
# Adjust user/password to match your local PostgreSQL install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_portal"
# Optional connection pool tuning (defaults shown)
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30

# --- JWT Secret ---
# Change this before any shared/staging deployment. Min 16 chars.
JWT_SECRET="change-me-local-dev-secret-please"
JWT_EXPIRES_IN="24h"

# --- App Settings ---
NODE_ENV="development"
APP_NAME="IT Complaint Management System"
PORT=3001
# Frontend origin(s) allowed by CORS. Comma-separated if more than one.
FRONTEND_URL="http://localhost:3000"

# --- Rate limiting (requests per IP per TTL window) ---
# Generous for local dev; tune down if you deploy to a public environment.
THROTTLE_LIMIT=600
THROTTLE_TTL=60000

# --- Email Settings (SMTP) ---
# Use your Gmail address and App Password (NOT your regular Gmail password)
# To get App Password: Google Account → Security → 2-Step Verification → App Passwords
MAIL_USER="youremail@gmail.com"
MAIL_PASSWORD="your-gmail-app-password"
MAIL_FROM="Finance Division Complaint Portal <youremail@gmail.com>"
